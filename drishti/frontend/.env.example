# Leave this UNSET to run the dashboard in demo mode with the built-in
# simulator. That is the deliberate fallback: a deploy with no backend still
# shows a working dashboard instead of an empty screen.
#
# Set it to your deployed backend to go live. No trailing slash.
# The WebSocket URL is derived from it (http -> ws, https -> wss).
#
# NEXT_PUBLIC_API_BASE=https://drishti-api.onrender.com
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Shown in the footer and recorded as `actor` on every veto/approve/dismiss.
# This is self-reported and NOT authentication — see the README's open issues.
# NEXT_PUBLIC_OPERATOR_ID=ops.sdma.demo
